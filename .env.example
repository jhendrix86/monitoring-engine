# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/monitoring

# Redis
REDIS_URL=redis://localhost:6379

# Prometheus
PROMETHEUS_URL=

# Monitoring intervals (seconds)
HEALTH_CHECK_INTERVAL=60
METRICS_COLLECTION_INTERVAL=30

# Alert thresholds (percent)
CPU_WARNING_THRESHOLD=80.0
CPU_CRITICAL_THRESHOLD=90.0
MEMORY_WARNING_THRESHOLD=80.0
MEMORY_CRITICAL_THRESHOLD=90.0

# Application
DEBUG=false

# Integration
NOTIFICATION_ENGINE_URL=http://localhost:8037

# Recipient for real alert notifications sent to notification-engine. Blank
# by default - notify_alert()/send_alert_notification() honestly skip
# sending until this is set, rather than notifying a fabricated address.
ALERT_NOTIFICATION_RECIPIENT=
